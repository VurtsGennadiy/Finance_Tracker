<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-accounts_credit_card-table" author="VurtsGD">
        <comment>Создание таблицы для кредитных карт</comment>

        <createTable tableName="accounts_card_credit">
            <column name="account_id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_accounts_card_credit"/>
            </column>
            <column name="bank_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="card_number" type="VARCHAR(16)"/>
            <column name="credit_limit" type="NUMERIC(14,2)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="accounts_card_credit"
                                 baseColumnNames="account_id"
                                 constraintName="fk_accounts_card_credit_base"
                                 referencedTableName="accounts_base"
                                 referencedColumnNames="account_id"
                                 onDelete="CASCADE" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="copy-accounts-card-to-credit-card" author="VurtsGD">
        <comment>Копирование счетов из таблицы accounts_card в таблицу accounts_card_credit</comment>
        <sql>
            insert into accounts_card_credit (account_id, bank_name, card_number, credit_limit)
            select account_id, bank_name, card_number, credit_limit from accounts_card
            where card_type = 'CREDIT';
        </sql>
    </changeSet>
</databaseChangeLog>