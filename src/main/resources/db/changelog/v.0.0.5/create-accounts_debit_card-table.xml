<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-accounts_debit_card-table" author="VurtsGD">
        <comment>Создание таблицы для дебетовых карт</comment>
        
        <createTable tableName="accounts_card_debit">
            <column name="account_id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_accounts_card_debit"/>
            </column>
            <column name="bank_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="card_number" type="VARCHAR(16)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="accounts_card_debit"
                                 baseColumnNames="account_id"
                                 constraintName="fk_accounts_card_debit_base"
                                 referencedTableName="accounts_base"
                                 referencedColumnNames="account_id"
                                 onDelete="CASCADE" onUpdate="CASCADE"/>
    </changeSet>
    
    <changeSet id="copy-accounts-card-to-debit-card" author="VurtsGD">
        <comment>Копирование счетов из таблицы accounts_card в таблицу accounts_card_debit</comment>
        <sql>
            insert into accounts_card_debit (account_id, bank_name, card_number)
            select account_id, bank_name, card_number from accounts_card
                where card_type = 'DEBIT';
        </sql>
    </changeSet>
</databaseChangeLog>