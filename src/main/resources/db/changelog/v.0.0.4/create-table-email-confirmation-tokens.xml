<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-table-email-confirmation-tokens" author="VurtsGD">
        <comment>Создание таблицы для хранения токенов подтверждения email</comment>

        <createTable tableName="email_confirmation_tokens">
            <column name="token" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_email_confirmation_tokens" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="current_timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="expired_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="email_confirmation_tokens"
                                 baseColumnNames="user_id"
                                 constraintName="fk_email_confirmation_tokens_users"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"
                                 onUpdate="CASCADE"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>