<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-users-created_at-field" author="VurtsGD">
        <comment>Добавление поля даты регистрации в таблицу users</comment>

        <addColumn tableName="users">
            <column name="created_at" type="timestamp"/>
        </addColumn>

        <update tableName="users">
            <column name="created_at" valueDate="2026-07-15 00:00:00"/>
        </update>

        <addNotNullConstraint tableName="users" columnName="created_at"/>

        <addDefaultValue tableName="users" columnName="created_at" defaultValueComputed="current_timestamp"/>
    </changeSet>
</databaseChangeLog>