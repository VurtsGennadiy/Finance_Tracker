<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="drop-account_owners-table" author="VurtsGD">
        <comment>
            Удаление таблицы account_owners: после переноса владельца в accounts_base.owner_id
            связь «многие ко многим» больше не используется, у счёта только один владелец.
        </comment>
        <dropTable tableName="account_owners"/>
    </changeSet>
</databaseChangeLog>
